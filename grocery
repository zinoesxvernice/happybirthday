<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Sweet Rush — Grocery Run</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&display=swap" rel="stylesheet">
<style>
  :root {
    --bg-pink: #FF9FCB;
    --dot-white: #FFFCF5;
    --title-pink: #FFB3DA;
    --stroke-cream: #FFF6E3;
    --shadow-deep: #D9448F;
    --accent-hot: #FF5FA8;
    --miss-red: #E23E57;
    --good-green: #3ED598;
    --shelf-brown: #C98A55;
    --shelf-dark: #A56A3B;
    --floor-a: #FFD3E9;
    --floor-b: #FFE6F3;
  }

  * { box-sizing: border-box; }

  html, body {
    margin: 0;
    padding: 0;
    height: 100%;
    overflow: hidden;
    -webkit-user-select: none;
    user-select: none;
  }

  body {
    background: var(--bg-pink);
    font-family: 'VT323', monospace;
    position: relative;
    height: 100vh;
    width: 100vw;
  }

  .arcade-text {
    font-family: 'Press Start 2P', monospace;
    color: var(--title-pink);
    -webkit-text-stroke: 2px var(--stroke-cream);
    paint-order: stroke fill;
  }

  /* ---- Store banner ---- */
  .store-banner {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 14vh;
    min-height: 90px;
    background: var(--shelf-brown);
    border-bottom: 6px solid var(--shelf-dark);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    z-index: 2;
  }

  .store-banner .sign {
    font-size: clamp(12px, 3vw, 22px);
    text-align: center;
    z-index: 2;
  }

  .shelf-row {
    position: absolute;
    bottom: 6px;
    left: 0; right: 0;
    display: flex;
    justify-content: space-evenly;
    z-index: 1;
  }

  .shelf-block {
    width: 22px;
    height: 26px;
    background: var(--stroke-cream);
    border: 3px solid var(--shelf-dark);
    border-radius: 2px;
  }

  /* ---- Floor / play area ---- */
  .play-area {
    position: absolute;
    top: 14vh;
    left: 0; right: 0; bottom: 0;
    background-image:
      linear-gradient(45deg, var(--floor-b) 25%, transparent 25%),
      linear-gradient(-45deg, var(--floor-b) 25%, transparent 25%),
      linear-gradient(45deg, transparent 75%, var(--floor-b) 75%),
      linear-gradient(-45deg, transparent 75%, var(--floor-b) 75%);
    background-size: 44px 44px;
    background-position: 0 0, 0 22px, 22px -22px, -22px 0px;
    background-color: var(--floor-a);
    overflow: hidden;
    touch-action: none;
    cursor: grab;
  }

  .falling-item {
    position: absolute;
    width: 40px;
    height: 52px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    filter: drop-shadow(2px 3px 0 rgba(0,0,0,0.25));
  }

  .falling-item canvas {
    image-rendering: pixelated;
    image-rendering: crisp-edges;
  }

  .falling-item .code {
    font-family: 'Press Start 2P', monospace;
    font-size: 6px;
    color: var(--shadow-deep);
    -webkit-text-stroke: 0.6px var(--stroke-cream);
    paint-order: stroke fill;
    text-align: center;
    line-height: 1.1;
    padding: 2px 0 0;
  }

  .checklist-icon {
    image-rendering: pixelated;
    image-rendering: crisp-edges;
    flex-shrink: 0;
  }

  .basket {
    position: absolute;
    bottom: 24px;
    width: 88px;
    height: 46px;
    background: var(--shelf-brown);
    border: 4px solid var(--shelf-dark);
    border-radius: 6px 6px 14px 14px;
    box-shadow: 0 6px 0 var(--shelf-dark);
  }
  .basket::before {
    content: "";
    position: absolute;
    top: -14px;
    left: 14px;
    width: 60px;
    height: 16px;
    border: 4px solid var(--shelf-dark);
    border-bottom: none;
    border-radius: 20px 20px 0 0;
  }

  /* ---- Checklist paper ---- */
  .checklist-paper {
    position: absolute;
    top: calc(14vh + 10px);
    right: 10px;
    width: 150px;
    background: var(--stroke-cream);
    border: 3px solid var(--shadow-deep);
    padding: 10px 10px 12px;
    z-index: 5;
    clip-path: polygon(
      0% 2%, 6% 0%, 20% 3%, 34% 0%, 48% 3%, 62% 0%, 78% 3%, 92% 0%, 100% 2%,
      100% 96%, 92% 100%, 78% 97%, 62% 100%, 48% 97%, 34% 100%, 20% 97%, 6% 100%, 0% 98%
    );
    box-shadow: 0 5px 10px rgba(0,0,0,0.2);
  }

  .checklist-title {
    font-family: 'Press Start 2P', monospace;
    font-size: 9px;
    color: var(--shadow-deep);
    text-align: center;
    margin-bottom: 8px;
    letter-spacing: 0.5px;
  }

  #checklist {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  #checklist li {
    display: flex;
    align-items: center;
    gap: 5px;
    font-family: 'VT323', monospace;
    font-size: 14px;
    color: var(--shadow-deep);
  }

  #checklist li .box {
    width: 14px;
    height: 14px;
    border: 2px solid var(--shadow-deep);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    line-height: 1;
  }

  #checklist li.done { opacity: 0.5; text-decoration: line-through; }
  #checklist li.done .box { background: var(--good-green); }

  /* ---- Touch controls ---- */
  .touch-controls {
    position: absolute;
    bottom: 14px;
    left: 14px;
    display: flex;
    gap: 10px;
    z-index: 6;
  }

  .touch-btn {
    font-family: 'Press Start 2P', monospace;
    font-size: 16px;
    width: 48px;
    height: 48px;
    color: var(--stroke-cream);
    background: var(--accent-hot);
    border: 3px solid var(--stroke-cream);
    border-radius: 8px;
    box-shadow: 0 4px 0 var(--shadow-deep);
  }
  .touch-btn:active {
    transform: translateY(3px);
    box-shadow: 0 1px 0 var(--shadow-deep);
  }

  /* ---- Feedback ---- */
  .toast {
    position: absolute;
    top: calc(14vh + 14px);
    left: 14px;
    font-family: 'Press Start 2P', monospace;
    font-size: 12px;
    color: var(--stroke-cream);
    -webkit-text-stroke: 1.5px var(--shadow-deep);
    z-index: 5;
    pointer-events: none;
    opacity: 0;
  }
  .toast.show {
    animation: toast-pop 0.8s ease-out forwards;
  }
  @keyframes toast-pop {
    0% { opacity: 0; transform: translateY(6px); }
    20% { opacity: 1; transform: translateY(0); }
    80% { opacity: 1; }
    100% { opacity: 0; transform: translateY(-10px); }
  }

  /* ---- Shake ---- */
  @keyframes shake {
    0%, 100% { transform: translateX(0); }
    20% { transform: translateX(-10px); }
    40% { transform: translateX(10px); }
    60% { transform: translateX(-8px); }
    80% { transform: translateX(8px); }
  }
  body.shake { animation: shake 0.35s linear; }

  /* ---- Overlays ---- */
  .overlay-screen {
    position: absolute;
    inset: 0;
    background: rgba(217,68,143,0.94);
    z-index: 30;
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 22px;
    text-align: center;
    padding: 24px;
  }
  .overlay-screen.show { display: flex; }

  .overlay-title {
    font-size: clamp(20px, 5vw, 32px);
    color: var(--stroke-cream);
    -webkit-text-stroke: 2px var(--accent-hot);
  }
  .overlay-sub {
    font-family: 'VT323', monospace;
    color: var(--stroke-cream);
    font-size: 22px;
  }
  .overlay-btn {
    font-family: 'Press Start 2P', monospace;
    font-size: 14px;
    color: var(--stroke-cream);
    -webkit-text-stroke: 1.5px var(--shadow-deep);
    background: var(--accent-hot);
    border: 4px solid var(--stroke-cream);
    border-radius: 10px;
    box-shadow: 0 6px 0 var(--shadow-deep);
    padding: 14px 24px;
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
  }
  .overlay-btn:active {
    transform: translateY(4px);
    box-shadow: 0 2px 0 var(--shadow-deep);
  }
</style>
</head>
<body>

  <div class="store-banner">
    <div class="sign arcade-text">SWEET RUSH MART</div>
    <div class="shelf-row" id="shelfRow"></div>
  </div>

  <div class="toast" id="toast"></div>

  <div class="play-area" id="playArea">
    <div class="basket" id="basket"></div>
  </div>

  <div class="checklist-paper">
    <div class="checklist-title">SHOPPING LIST</div>
    <ul id="checklist"></ul>
  </div>

  <div class="touch-controls">
    <button class="touch-btn" id="leftBtn">◀</button>
    <button class="touch-btn" id="rightBtn">▶</button>
  </div>

  <div class="overlay-screen" id="gameOverScreen">
    <div class="overlay-title arcade-text">OOPS!</div>
    <div class="overlay-sub">That's not on the list. List cleared — try again!</div>
    <button class="overlay-btn" id="retryBtn">TRY AGAIN</button>
  </div>

  <div class="overlay-screen" id="winScreen">
    <div class="overlay-title arcade-text">CART'S FULL!</div>
    <div class="overlay-sub">Got everything on the list.</div>
    <a class="overlay-btn" href="game.html">START BAKING ▶</a>
  </div>

<script>
  const GOOD_ITEMS = [
    { code: "FLOUR" },
    { code: "EGGS" },
    { code: "SUGAR" },
    { code: "BUTTER" },
    { code: "MILK" },
    { code: "SPRINKLES" },
  ];

  const BAD_ITEMS = [
    { code: "FISH" },
    { code: "SOAP" },
    { code: "BULB" },
    { code: "SHOE" },
    { code: "BATTERY" },
  ];

  // 8x8 pixel-grid sprites. '.' = transparent, other chars map to palette colors.
  const SPRITES = {
    FLOUR: {
      palette: { e: "#8B5E34", t: "#8B5E34", b: "#F4E4C1" },
      grid: [
        ".ettte..",
        ".eeeeee.",
        "ebbbbbbe",
        "ebbbbbbe",
        "ebbbbbbe",
        "ebbbbbbe",
        "ebbbbbbe",
        "eeeeeeee",
      ],
    },
    EGGS: {
      palette: { o: "#C9A46B", e: "#FFFDF5" },
      grid: [
        "..oooo..",
        ".oeeeeo.",
        "oeeeeeeo",
        "oeeeeeeo",
        "oeeeeeeo",
        "oeeeeeeo",
        ".oeeeeo.",
        "..oooo..",
      ],
    },
    SUGAR: {
      palette: { e: "#D8D8D8", b: "#FFFFFF", R: "#E23E57" },
      grid: [
        ".bbbbbb.",
        "ebbbbbbe",
        "ebbbbbbe",
        "eRRRRRRe",
        "ebbbbbbe",
        "ebbbbbbe",
        "ebbbbbbe",
        "eeeeeeee",
      ],
    },
    BUTTER: {
      palette: { e: "#C9932A", w: "#FFF6E3", b: "#FFD23F" },
      grid: [
        "eeeeeeee",
        "ewwwwwwe",
        "ebbbbbbe",
        "ebbbbbbe",
        "ebbbbbbe",
        "ebbbbbbe",
        "ewwwwwwe",
        "eeeeeeee",
      ],
    },
    MILK: {
      palette: { o: "#6FA8D6", e: "#3C7CA6", c: "#EAF6FF" },
      grid: [
        "..oooo..",
        ".oeeeeo.",
        "ecccccce",
        "ecccccce",
        "ecccccce",
        "ecccccce",
        "ecccccce",
        "eeeeeeee",
      ],
    },
    SPRINKLES: {
      palette: {
        e: "#D9448F",
        l: "#FF9FCB",
        g: "#FFF6E3",
        "1": "#FF5FA8",
        "2": "#3ED598",
        "3": "#FFD23F",
      },
      grid: [
        ".ellle..",
        ".elllle.",
        "egggggge",
        "eg1g2g3e",
        "eg3g1g2e",
        "egggggge",
        "egggggge",
        "eeeeeeee",
      ],
    },
    FISH: {
      palette: { e: "#5C8A76", b: "#8FB9A8", t: "#5C8A76", o: "#2B2B2B" },
      grid: [
        "..eeee..",
        ".ebbbbe.",
        "ebbbbbbe",
        "tbbbbobe",
        "ebbbbbbe",
        ".ebbbbe.",
        "..eeee..",
        "........",
      ],
    },
    SOAP: {
      palette: { e: "#7C93AC", f: "#B5C7DB" },
      grid: [
        ".eeeeee.",
        "effffffe",
        "effffffe",
        "effffffe",
        "effffffe",
        "effffffe",
        "effffffe",
        ".eeeeee.",
      ],
    },
    BULB: {
      palette: { e: "#C9932A", g: "#FFE9A8", s: "#5C5C5C", b: "#8C8C8C" },
      grid: [
        "..eeee..",
        ".egggge.",
        "egggggge",
        "egggggge",
        ".egggge.",
        "..ssss..",
        "..bbbb..",
        "..bbbb..",
      ],
    },
    SHOE: {
      palette: { e: "#5C4432", a: "#8A6650", s: "#3C3C3C" },
      grid: [
        "..eeee..",
        ".eaaaae.",
        "eaaaaaae",
        "eaaaaaae",
        "eaaaaaae",
        "esssssse",
        ".ssssss.",
        "........",
      ],
    },
    BATTERY: {
      palette: { c: "#D4A24C", e: "#5C5C5C", b: "#8C8C8C", s: "#3C3C3C" },
      grid: [
        "..cccc..",
        "..cccc..",
        "ebbbbbbe",
        "ebbbbbbe",
        "esssssse",
        "ebbbbbbe",
        "ebbbbbbe",
        "eeeeeeee",
      ],
    },
  };

  function drawSprite(code, sizePx) {
    const sprite = SPRITES[code];
    const canvas = document.createElement("canvas");
    const cell = sizePx / 8;
    canvas.width = sizePx;
    canvas.height = sizePx;
    canvas.style.width = sizePx + "px";
    canvas.style.height = sizePx + "px";
    canvas.className = "checklist-icon";
    const ctx = canvas.getContext("2d");
    ctx.imageSmoothingEnabled = false;
    sprite.grid.forEach((row, y) => {
      for (let x = 0; x < row.length; x++) {
        const ch = row[x];
        if (ch === ".") continue;
        ctx.fillStyle = sprite.palette[ch];
        ctx.fillRect(x * cell, y * cell, cell, cell);
      }
    });
    return canvas;
  }

  const playArea = document.getElementById("playArea");
  const basket = document.getElementById("basket");
  const checklistEl = document.getElementById("checklist");
  const toastEl = document.getElementById("toast");
  const shelfRow = document.getElementById("shelfRow");

  let collected = new Set();
  let basketX = 0;
  let items = [];
  let spawnTimer = null;
  let rafId = null;
  let running = false;
  let keyLeft = false, keyRight = false;

  // decorative shelf products
  for (let i = 0; i < 10; i++) {
    const b = document.createElement("div");
    b.className = "shelf-block";
    shelfRow.appendChild(b);
  }

  function buildChecklist() {
    checklistEl.innerHTML = "";
    GOOD_ITEMS.forEach(item => {
      const li = document.createElement("li");
      li.dataset.code = item.code;
      const box = document.createElement("span");
      box.className = "box";
      const icon = drawSprite(item.code, 18);
      const label = document.createElement("span");
      label.textContent = item.code;
      li.appendChild(box);
      li.appendChild(icon);
      li.appendChild(label);
      checklistEl.appendChild(li);
    });
  }

  function markChecklist(code) {
    const li = checklistEl.querySelector(`li[data-code="${code}"]`);
    if (li) {
      li.classList.add("done");
      li.querySelector(".box").textContent = "✓";
    }
  }

  function resetChecklist() {
    collected.clear();
    checklistEl.querySelectorAll("li").forEach(li => {
      li.classList.remove("done");
      li.querySelector(".box").textContent = "";
    });
  }

  function showToast(text) {
    toastEl.textContent = text;
    toastEl.classList.remove("show");
    void toastEl.offsetWidth;
    toastEl.classList.add("show");
  }

  function initBasket() {
    const areaWidth = playArea.clientWidth;
    basketX = areaWidth / 2 - basket.clientWidth / 2;
    basket.style.left = basketX + "px";
  }

  function spawnItem() {
    const remainingGood = GOOD_ITEMS.filter(g => !collected.has(g.code));
    const pool = remainingGood.length ? remainingGood : GOOD_ITEMS;
    const spawnBad = Math.random() < 0.35;
    const source = spawnBad ? BAD_ITEMS : pool;
    const chosen = source[Math.floor(Math.random() * source.length)];

    const el = document.createElement("div");
    el.className = "falling-item";
    el.appendChild(drawSprite(chosen.code, 40));
    const label = document.createElement("div");
    label.className = "code";
    label.textContent = chosen.code;
    el.appendChild(label);

    const areaWidth = playArea.clientWidth;
    const x = Math.random() * (areaWidth - 44);
    el.style.left = x + "px";
    el.style.top = "-44px";
    playArea.appendChild(el);

    items.push({
      el,
      x,
      y: -44,
      speed: 1.4 + Math.random() * 0.9,
      code: chosen.code,
      isBad: spawnBad,
      caught: false,
    });
  }

  function loop() {
    if (!running) return;
    const areaHeight = playArea.clientHeight;
    const basketRect = {
      left: basketX,
      right: basketX + basket.clientWidth,
      top: areaHeight - 24 - basket.clientHeight,
    };

    items.forEach(item => {
      if (item.caught) return;
      item.y += item.speed;
      item.el.style.top = item.y + "px";

      const itemBottom = item.y + 40;
      const itemLeft = item.x;
      const itemRight = item.x + 40;

      const overlapsX = itemRight > basketRect.left && itemLeft < basketRect.right;
      const reachesBasket = itemBottom >= basketRect.top;

      if (overlapsX && reachesBasket && itemBottom < basketRect.top + 30) {
        item.caught = true;
        item.el.remove();
        handleCatch(item);
      } else if (item.y > areaHeight) {
        item.caught = true;
        item.el.remove();
      }
    });

    items = items.filter(i => !i.caught);

    if (keyLeft) basketX -= 6;
    if (keyRight) basketX += 6;
    basketX = Math.max(0, Math.min(playArea.clientWidth - basket.clientWidth, basketX));
    basket.style.left = basketX + "px";

    rafId = requestAnimationFrame(loop);
  }

  function handleCatch(item) {
    if (item.isBad) {
      triggerGameOver();
      return;
    }
    if (!collected.has(item.code)) {
      collected.add(item.code);
      markChecklist(item.code);
      showToast("GOT " + item.code + "!");
      if (collected.size === GOOD_ITEMS.length) {
        triggerWin();
      }
    } else {
      showToast("HAVE ENOUGH " + item.code);
    }
  }

  function triggerGameOver() {
    running = false;
    clearInterval(spawnTimer);
    cancelAnimationFrame(rafId);
    document.body.classList.add("shake");
    setTimeout(() => {
      document.body.classList.remove("shake");
      items.forEach(i => i.el.remove());
      items = [];
      document.getElementById("gameOverScreen").classList.add("show");
    }, 350);
  }

  function triggerWin() {
    running = false;
    clearInterval(spawnTimer);
    cancelAnimationFrame(rafId);
    setTimeout(() => {
      items.forEach(i => i.el.remove());
      items = [];
      document.getElementById("winScreen").classList.add("show");
    }, 300);
  }

  function startGame() {
    resetChecklist();
    items.forEach(i => i.el.remove());
    items = [];
    initBasket();
    running = true;
    spawnTimer = setInterval(spawnItem, 850);
    rafId = requestAnimationFrame(loop);
  }

  // Keyboard controls
  document.addEventListener("keydown", (e) => {
    if (e.key === "ArrowLeft") keyLeft = true;
    if (e.key === "ArrowRight") keyRight = true;
  });
  document.addEventListener("keyup", (e) => {
    if (e.key === "ArrowLeft") keyLeft = false;
    if (e.key === "ArrowRight") keyRight = false;
  });

  // Touch buttons (hold to move)
  function bindHold(btn, setFlag) {
    const on = () => setFlag(true);
    const off = () => setFlag(false);
    btn.addEventListener("mousedown", on);
    btn.addEventListener("touchstart", (e) => { e.preventDefault(); on(); });
    ["mouseup", "mouseleave", "touchend", "touchcancel"].forEach(ev =>
      btn.addEventListener(ev, off)
    );
  }
  bindHold(document.getElementById("leftBtn"), v => keyLeft = v);
  bindHold(document.getElementById("rightBtn"), v => keyRight = v);

  // Drag directly on play area
  function moveBasketTo(clientX) {
    const rect = playArea.getBoundingClientRect();
    basketX = clientX - rect.left - basket.clientWidth / 2;
    basketX = Math.max(0, Math.min(playArea.clientWidth - basket.clientWidth, basketX));
    basket.style.left = basketX + "px";
  }
  playArea.addEventListener("mousemove", (e) => moveBasketTo(e.clientX));
  playArea.addEventListener("touchmove", (e) => {
    e.preventDefault();
    moveBasketTo(e.touches[0].clientX);
  }, { passive: false });

  document.getElementById("retryBtn").addEventListener("click", () => {
    document.getElementById("gameOverScreen").classList.remove("show");
    startGame();
  });

  buildChecklist();
  window.addEventListener("resize", initBasket);
  startGame();
</script>

</body>
</html>
